{'parsed_response': "class Solution:\n    def maxAbsoluteSum(self, nums: List[int]) -> int:\n        max_subarray_sum = float('-inf')\n        min_subarray_sum = float('inf')\n        current_max = 0\n        current_min = 0\n        \n        for num in nums:\n            current_max = max(num, current_max + num)\n            current_min = min(num, current_min + num)\n            max_subarray_sum = max(max_subarray_sum, current_max)\n            min_subarray_sum = min(min_subarray_sum, current_min)\n        \n        return max(abs(max_subarray_sum), abs(min_subarray_sum))", 'is_formatted': True, 'can_compile': True, 'pass_rate': 1.0, 'tests_passed': 110, 'tests_evaluated': 110, 'tests_total': 110, 'test_errors': []}
